# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình, tin nhắn nhóm.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# Mỗi tên biến chỉ xuất hiện MỘT lần (khai báo trùng thì dòng sau thắng).
# KEY CHỈ NẰM Ở BACKEND (Python). Frontend/trình duyệt không bao giờ được cầm key: mọi biến VITE_* bị nhúng công khai vào bundle.

# ═══ 1. KEY THEO NHÀ CUNG CẤP ═══ điền nhà nào dùng nhà đó, nhà nào trống thì không gọi được
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Địa chỉ API. OpenRouter và DeepSeek đều theo kiểu OpenAI (/chat/completions), nên dùng chung một client, chỉ đổi base URL + key.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ═══ 2. MODEL THEO VAI TRÒ ═══ mỗi vai trò chọn nhà cung cấp + model riêng
# provider: openrouter | openai | deepseek | fake (giả, token 0) | (thêm sau: anthropic, gemini, ollama …)
# model:    đúng mã gọi API ở tài liệu nhà cung cấp. OpenRouter dạng <hãng>/<model>; DeepSeek vd deepseek-chat, deepseek-reasoner.
# Vai trò nào để trống → dùng model MẶC ĐỊNH ở mục 3. Tên model phải khớp bảng giá khi chạy `run.py simulate` (cost/).
#   AGENT: vòng tool chính của agent soi đơn (lập kế hoạch, tách dòng, gọi công cụ, kết luận). Cần model mạnh, gọi tool ổn định.
#   FAST:  việc nhẹ và nhiều lượt (phân loại đơn, lọc yêu cầu xấu, tách chữ dán, viết nháp câu hỏi). Chọn model rẻ.
#   CHAT:  agent trò chuyện trên cửa sổ chat của frontend (hỏi đáp, thao tác công tắc, "nếu hạ hoa hồng thì sao"). Cần trả lời nhanh.
LLM_AGENT_PROVIDER=
LLM_AGENT_MODEL=
LLM_FAST_PROVIDER=
LLM_FAST_MODEL=
LLM_CHAT_PROVIDER=
LLM_CHAT_MODEL=
# Chung cho mọi vai trò
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60

# ═══ 3. MODEL MẶC ĐỊNH ═══ đây là 3 biến codebase/ai.py đang đọc (hợp đồng của khung, giữ nguyên tên)
# MODEL_PROVIDER trống hoặc fake = chế độ giả. API_KEY chỉ dùng khi nhà cung cấp tương ứng ở mục 1 để trống.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=

# ═══ 4. EMBEDDING KHO CHÍNH SÁCH ═══ codebase/retrieval.py, scripts/policies/embed.py
# Kho data/<sàn>/policies/index.jsonl và data/policies/index.jsonl đã embed bằng bge-m3 local. Câu hỏi lúc chạy phải dùng ĐÚNG model đó,
# nếu không vector không khớp và search_policy rơi về BM25.
#   local  → BAAI/bge-m3 chạy trên máy (pip install sentence-transformers; không cần key; tải ~2 GB lần đầu)
#   gemini → gọi API Gemini (cần EMBED_API_KEY); phải embed lại cả 3 sàn. EMBED_MODEL=gemini-embedding-001, EMBED_DIM=768
EMBED_PROVIDER=local
EMBED_MODEL=bge-m3
EMBED_DIM=1024
EMBED_API_KEY=
# Ngưỡng cosine của nhánh vector (0.62 chọn cho Gemini; với bge-m3 kết quả đúng thường 0.64–0.80, chỉnh sau khi chạy bộ câu thử).
POLICY_MIN_SCORE=0.62
# Tỉ lệ từ khoá của câu hỏi phải có trong chunk thì nhánh BM25 mới nhận.
POLICY_MIN_COVER=0.6

# ═══ 5. rag/pipeline.py (pipeline Shopee cũ, rag/README.md) ═══ chỉ cần khi chạy `python rag/pipeline.py embed`; tiền tố RAG_ để không đụng mục 4
RAG_EMBED_PROVIDER=openrouter
RAG_EMBED_MODEL=openai/text-embedding-3-small
RAG_EMBED_DIM=1536
RAG_EMBED_API_KEY=

# ═══ 6. API (codebase/app.py --serve, PR #7) ═══
# Origin của frontend được gọi API, cách nhau dấu phẩy. Trống = http://localhost:5173, 127.0.0.1:5173 (Vite dev), :4173 (preview).
# Request có Origin khác bị 403. "*" = mở cho mọi origin (chỉ khi tự chịu rủi ro). Request không có Origin (curl, test) luôn qua.
API_ALLOWED_ORIGINS=

# ═══ 7. FRONTEND (không phải file này) ═══
# Frontend đọc frontend/.env.local (cũng đã bị .gitignore chặn bởi .env.*). Chỉ đặt địa chỉ backend, KHÔNG đặt key:
#   VITE_API_URL=http://localhost:8000      # trùng cổng server của Thái (TH-7); chat cũng đi qua server này
